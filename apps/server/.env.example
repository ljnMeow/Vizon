# PostgreSQL 连接信息（把这个文件复制成 .env，并填上你的真实配置）
#
# Django 会在启动时读取这些环境变量；
# 本项目**强制使用 PostgreSQL**，未配置/配置错误会直接报错（不会回落 sqlite）。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vizon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# 数据库连接池（秒）。0=每次请求新建连接；生产可设为 60
POSTGRES_CONN_MAX_AGE=0

# Django 安全（必须显式配置，无默认值）
# 本地开发可生成：pnpm server:secret-key（将输出粘贴到下方 SECRET_KEY=）
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1

# 固定本地开发端口（可选）
# - 如果不设置，`pnpm dev:server` 会自动找一个空闲端口
PORT=8001

# 开发/初始化阶段开关（仅影响 /api/customers/ 是否免鉴权）：
# - 1：客户 CRUD 免登录，便于灌数
# - 0：客户 CRUD 也需 JWT（生产推荐）
# 资源 API（scenes/textures/models3d）始终需要登录。
OPEN_API_AUTH=0

# Redis（refresh token 会话 / Channels / Celery）
# 例子：
# - 无密码：redis://127.0.0.1:6379/0
# - 有密码（requirepass）：redis://:YOUR_PASSWORD@127.0.0.1:6379/0
# - ACL（用户名+密码）：redis://YOUR_USER:YOUR_PASSWORD@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# token 过期时间（单位：秒）
ACCESS_TOKEN_EXPIRES_SECONDS=120
REFRESH_TOKEN_EXPIRES_SECONDS=300

# 列表分页默认每页条数（可选，默认 20）
API_PAGE_SIZE=20
